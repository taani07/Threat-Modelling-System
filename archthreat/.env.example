# Everything works offline with the defaults: rules only, no LLM.
LLM_PROVIDER=fake              # fake | ollama | anthropic | bedrock
# LLM_MODEL=qwen2.5:7b
EMBED_PROVIDER=hash            # hash | ollama | bedrock
OLLAMA_HOST=http://localhost:11434
# ANTHROPIC_API_KEY=sk-ant-...
AWS_REGION=us-east-1
ARCHTHREAT_HOME=.archthreat
ARCHTHREAT_MAX_LLM_THREATS=3
# ARCHTHREAT_API_KEY=change-me  # if set, the REST API requires X-API-Key
